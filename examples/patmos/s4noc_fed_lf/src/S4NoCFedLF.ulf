
reactor Src(id: int = 0) {
  output out: int
  timer t(0, 100 msec)
  state s: int = 1
  
  reaction(startup) -> out{=
    printf("Hello Patmos from Src!\n"); 
    self->s = self->id;
  =}

  reaction (t) -> out {=
    printf("Patmos:Sending %d to Dst\n", self->s); 
    lf_set(out, self->s);
    ++self->s;
    if (self->s > 43) {
      env->request_shutdown(env, MSEC(0));
    }
  =}
}

reactor Dst {
  input in: int
  state check: bool = false

  reaction(startup) {=
    printf("Hello Patmos from Dst!\n"); 
  =}

  reaction(in) {= 
    printf("Patmos:Received %d from Src\n", in->value); 
    if (in->value >= 43) {
      self->check = true;
      env->request_shutdown(env, MSEC(0));
    }
  =}

  reaction(shutdown) {=
    validate(self->check);
  =}
}

@platform("PATMOS")
@clock_sync("off")
@keepalive(true)
@timeout(120s)
federated reactor {
  @interface_s4noc(core=2) 
  r1 = new Src(id=42)

  @interface_s4noc(core=1) 
  r2 = new Dst()

  // Without an explicit maxwait, federated inputs default to waiting FOREVER for
  // their tag to become known. S4NoC sends no "absent"/tag-advance messages, so
  // after r1 shuts down, r2 could never acquire the shutdown tag and would hang.
  @buffer(200)
  @maxwait(10ms)
  r1.out -> r2.in
}
