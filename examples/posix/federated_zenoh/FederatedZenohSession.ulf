// FederatedZenoh.ulf for federates whose application already has a Zenoh session, for example
// because it uses Zenoh for its own data: `session` hands that session to the channels, which
// then open none of their own. Here the preamble stands in for such an application.
preamble {=
  #include <zenoh-pico.h>

  // The session of the application, opened on first use.
  static inline const z_loaned_session_t* application_session(const char* listen, const char* connect) {
    static z_owned_session_t session;
    static bool is_open = false;
    if (!is_open) {
      z_owned_config_t config;
      z_config_default(&config);
      zp_config_insert(z_loan_mut(config), Z_CONFIG_MODE_KEY, "peer");
      if (listen != NULL) {
        zp_config_insert(z_loan_mut(config), Z_CONFIG_LISTEN_KEY, listen);
      }
      if (connect != NULL) {
        zp_config_insert(z_loan_mut(config), Z_CONFIG_CONNECT_KEY, connect);
      }
      validate(z_open(&session, z_move(config), NULL) == Z_OK);
      is_open = true;
    }
    return z_loan(session);
  }
=}


reactor Src(id: int = 0) {
  output out: int
  input in: bool
  reaction(startup) -> out{=
    printf("Hello from Src!\n");
    lf_set(out, self->id);
  =}

  reaction(in) {=
    printf("Received message from Dst!");
    env->request_shutdown(env, MSEC(0));
  =}
}

reactor Dst {
  input in: int
  output out: bool
  state check: bool = false
  reaction(startup) {=
    printf("Hello from Dst!\n");
  =}
  reaction(in) -> out {=
    printf("Received %d from Src\n", in->value);
    validate(in->value == 42);
    self->check = true;
    env->request_shutdown(env, MSEC(0));
    lf_set(out, true);
  =}

  reaction(shutdown) {=
    validate(self->check);
  =}
}

@platform("native")
federated reactor {
  @interface_zenoh(session="application_session(\"tcp/127.0.0.1:17448\", NULL)")
  @maxwait(100ms)
  r1 = new Src(id=42)
  @interface_zenoh(session="application_session(NULL, \"tcp/127.0.0.1:17448\")")
  @maxwait(100ms)
  r2 = new Dst()
  r1.out -> r2.in
  r2.out -> r1.in
}
