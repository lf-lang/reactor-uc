// r2 has a timer whose offset (1 s) lies after the federation's timeout (100 ms).
// The timer never fires, so the program should just run until the timeout.
reactor Src {
  output out: int
  reaction(startup) -> out {=
    lf_set(out, 1);
  =}
}

reactor Dst {
  input in: int
  timer late(1 s)
  state got: bool = false
  reaction(in) {=
    self->got = true;
  =}
  reaction(late) {=
    printf("late timer fired (should not happen)\n");
  =}
  reaction(shutdown) {=
    printf("r2 shutting down normally, got=%d\n", self->got);
    validate(self->got);
  =}
}

@platform("native")
@timeout(100ms)
federated reactor {
  r1 = new Src()
  r2 = new Dst()
  r1.out -> r2.in
}
